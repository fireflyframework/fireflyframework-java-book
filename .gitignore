# ─────────────────────────────────────────────────────────────
# Firefly for Java by Example — .gitignore
# This repo holds the book pipeline (build/*.py), the theme + bundled
# fonts (theme/), the art (art/), and the companion Maven reactor
# (samples/lumen-lending). Those are tracked deliverables; only build
# output, environments, and OS/IDE noise are ignored below.
# ─────────────────────────────────────────────────────────────

# ── Operating system ──
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── Java / Maven (the sample reactor) ──
target/
*.class
*.hprof
dependency-reduced-pom.xml
release.properties
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ── Python (the book build toolchain) ──
build/.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── IDEs & editors ──
.idea/
*.iml
*.ipr
*.iws
.vscode/
.project
.classpath
.settings/
.factorypath
nbproject/
*.swp
*.swo
*~

# ── Built book artifacts ──
# The EPUB/PDF are built fresh by CI and attached to GitHub Releases;
# dist/.gitkeep keeps the directory in the tree.
dist/*.pdf
dist/*.epub

# ── Logs & scratch ──
*.log
*.tmp
.cache/
